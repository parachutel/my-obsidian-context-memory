{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.agents/skills/obsidian-context-memory/scripts/obsidian_memory.py\" --config \"${CODEX_HOME:-$HOME/.codex}/obsidian-context-memory/config.json\" hook",
            "timeout": 8,
            "statusMessage": "Loading Obsidian project memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.agents/skills/obsidian-context-memory/scripts/obsidian_memory.py\" --config \"${CODEX_HOME:-$HOME/.codex}/obsidian-context-memory/config.json\" hook",
            "timeout": 8,
            "statusMessage": "Recalling Obsidian task context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/.agents/skills/obsidian-context-memory/scripts/obsidian_memory.py\" --config \"${CODEX_HOME:-$HOME/.codex}/obsidian-context-memory/config.json\" hook",
            "timeout": 8,
            "statusMessage": "Checking Obsidian task archive"
          }
        ]
      }
    ]
  }
}
